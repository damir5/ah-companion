{
	"description": "Agent Hub companion hooks — codex flavor (Stop-block delivery; idle wake via `codex queue`).",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume|clear|compact",
				"hooks": [
					{
						"type": "command",
						"command": "AH_COMPANION_HARNESS=codex $CLAUDE_PLUGIN_ROOT/hooks/session-start.sh",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "AH_COMPANION_HARNESS=codex $CLAUDE_PLUGIN_ROOT/hooks/stop.sh",
						"timeout": 15
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "AH_COMPANION_HARNESS=codex $CLAUDE_PLUGIN_ROOT/hooks/user-prompt-submit.sh",
						"timeout": 10
					}
				]
			}
		],
		"SessionEnd": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "AH_COMPANION_HARNESS=codex $CLAUDE_PLUGIN_ROOT/hooks/session-end.sh",
						"timeout": 3
					}
				]
			}
		]
	}
}
